.match-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 24px;
    position: relative; /* anchors the .end-screen overlay */
}

.match-hud {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    max-width: 480px;
    margin-bottom: 16px;
}

.match-hud__round, .match-hud__timer {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
}

.match-grid {
    max-width: 480px;
}

.match-row {
    flex-direction: row;
    justify-content: center;
}

.match-card {
    width: 96px;
    height: 96px;
    margin: 6px;
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(60, 60, 60);
}

.match-card__face {
    flex-grow: 1;
    border-radius: 8px;
}

/* ---------- End-of-run overlay ---------- */

.end-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(10, 12, 20, 0.92);
    align-items: center;
    justify-content: center;
}

.end-title {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
    margin-bottom: 12px;
}

.end-stat {
    font-size: 20px;
    color: rgb(220, 220, 220);
    margin-bottom: 4px;
}

.end-pb {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(0, 200, 130);
    margin-top: 8px;
    margin-bottom: 8px;
}

.end-retry-button {
    margin-top: 20px;
    padding: 10px 28px;
    font-size: 18px;
    -unity-font-style: bold;
    border-radius: 10px;
    background-color: rgb(0, 150, 220);
    color: rgb(255, 255, 255);
    border-width: 0;
}

.end-retry-button:hover {
    background-color: rgb(20, 170, 240);
}
