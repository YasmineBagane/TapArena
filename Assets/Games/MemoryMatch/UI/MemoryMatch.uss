.match-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 24px;
}

.match-hud {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    max-width: 480px;
    margin-bottom: 16px;
}

.match-hud__round, .match-hud__timer {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
}

.match-grid {
    max-width: 480px;
}

.match-row {
    flex-direction: row;
    justify-content: center;
}

.match-card {
    width: 96px;
    height: 96px;
    margin: 6px;
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(60, 60, 60);
}

.match-card__face {
    flex-grow: 1;
    border-radius: 8px;
}

/* Face-down: plain back, placeholder color/icon hidden underneath. */
.match-card--face-down {
    background-color: rgb(45, 50, 65);
}
.match-card--face-down .match-card__face {
    background-color: rgba(0, 0, 0, 0);
}

/* Face-up: reveals the placeholder color set in Init(). */
.match-card--face-up {
    background-color: rgb(250, 250, 250);
}

/* Matched: stays face-up, dims to read as "cleared"; non-interactive is enforced in code. */
.match-card--matched {
    background-color: rgb(250, 250, 250);
    opacity: 0.45;
}
